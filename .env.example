# Шаблон файла секретов для send.php
# Скопируйте этот файл в .env и заполните реальными значениями.
# .env в .gitignore — не попадёт в репозиторий.

# Telegram (создайте бота через @BotFather)
TG_BOT_TOKEN=
TG_CHAT_ID=

# ВКонтакте (сообщество, раздел "Работа с API")
VK_TOKEN=
VK_USER_ID=
VK_API_V=5.199
